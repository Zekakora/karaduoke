:root {
  --ink: #102a43;
  --muted: #627d98;
  --line: #d9e2ec;
  --paper: #f5f8fb;
  --card: #ffffff;
  --navy: #102a43;
  --teal: #19a7a0;
  --yellow: #f4c95d;
  --red: #e25c5c;
  --shadow: 0 18px 50px rgba(16, 42, 67, 0.08);
}

html[data-theme="night"] {
  --ink: #e6eef5;
  --muted: #9fb3c8;
  --line: #29465e;
  --paper: #07131f;
  --card: #0d2031;
  --navy: #2a5878;
  --shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
}
html[data-theme="night"] body { background:var(--paper); color:var(--ink); }
html[data-theme="night"] .topbar { background:rgba(13,32,49,.94); border-color:rgba(159,179,200,.18); }
html[data-theme="night"] .card, html[data-theme="night"] .result { border-color:rgba(159,179,200,.18); }
html[data-theme="night"] .input, html[data-theme="night"] .select { background:#102a43; color:var(--ink); border-color:#29465e; }
html[data-theme="night"] .btn.ghost { background:#17364d; color:var(--ink); }
html[data-theme="night"] .btn.soft { background:#123d47; color:#8debe4; }
html[data-theme="night"] .btn.danger { background:#512b32; color:#ffb8b8; }
html[data-theme="night"] .result { background:#0d2031; }
html[data-theme="night"] .tag { background:#17364d; color:#b7cad8; }
html[data-theme="night"] .tag.pin { background:#4b401c; color:#f4d77b; }
html[data-theme="night"] .notice { background:#3b341f; color:#f4d77b; }
html[data-theme="night"] .song-row, html[data-theme="night"] .queue-item, html[data-theme="night"] .user-row { border-color:rgba(159,179,200,.14); }
html[data-theme="night"] .login-wrap { background:radial-gradient(circle at 20% 10%, #123d47, transparent 35%), var(--paper); }

* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; font-family: "Manrope", "Noto Sans SC", sans-serif; color: var(--ink); background: var(--paper); }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; border: 0; }
.app-shell { min-height: 100vh; }
.topbar { height: 72px; padding: 0 5vw; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(217,226,236,.8); background: rgba(255,255,255,.92); backdrop-filter: blur(16px); position: sticky; top: 0; z-index: 10; }
.brand { display:flex; align-items:center; gap:12px; font-weight:800; letter-spacing:-.03em; }
.brand-mark { width:34px; height:34px; border-radius:11px; display:block; object-fit:cover; flex:0 0 34px; }
.brand span:last-child { font-size: 16px; }
.top-actions { display:flex; align-items:center; gap: 10px; }
.eyebrow { color: var(--teal); font-size: 11px; font-weight:800; text-transform: uppercase; letter-spacing:.16em; }
.page { width: min(1240px, 90vw); margin: 0 auto; padding: 42px 0 70px; }
.page.compact { width: min(1480px, 94vw); }
.hero { display:flex; align-items:flex-end; justify-content:space-between; gap: 24px; margin-bottom: 28px; }
.hero h1 { margin: 5px 0 9px; font-size: clamp(29px, 4vw, 52px); letter-spacing:-.06em; line-height:1; }
.hero p { margin:0; color: var(--muted); font-size:14px; max-width: 650px; line-height:1.7; }
.session-switch { margin-top:8px !important; font-size:12px !important; line-height:1.5 !important; }
.session-switch strong { color:var(--ink); }
.text-link { padding:0; background:none; color:var(--teal); text-decoration:underline; font-size:inherit; font-weight:800; }
.card { background: var(--card); border: 1px solid rgba(217,226,236,.75); border-radius: 20px; box-shadow: var(--shadow); }
.panel { padding: 24px; }
.btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius: 11px; padding: 11px 15px; font-weight:800; font-size:13px; transition: transform .15s, box-shadow .15s, background .15s; }
.btn:hover { transform: translateY(-1px); }
.btn.primary { background: var(--navy); color:white; box-shadow: 0 8px 18px rgba(16,42,67,.16); }
.btn.teal { background: var(--teal); color:white; }
.btn.soft { background:#edf7f6; color:#127f7a; }
.btn.ghost { color:var(--ink); background:#f3f6f9; }
.btn.danger { background:#fff0f0; color:#c14848; }
.btn.small { padding: 8px 11px; border-radius:9px; font-size:12px; }
.input, .select { width:100%; border:1px solid var(--line); border-radius:11px; padding:12px 13px; color:var(--ink); background:#fbfdff; outline:none; }
.input:focus, .select:focus { border-color:var(--teal); box-shadow:0 0 0 3px rgba(25,167,160,.12); }
.field { display:grid; gap:7px; }
.field label { color:var(--muted); font-size:12px; font-weight:800; }
.grid { display:grid; gap:18px; }
.grid.two { grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); }
.grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.stat-row { display:grid; grid-template-columns: repeat(4,1fr); gap:14px; margin-bottom:18px; }
.stat { padding:18px 20px; }
.stat .label { color:var(--muted); font-size:12px; font-weight:700; }
.stat .value { font-size:30px; font-weight:800; letter-spacing:-.06em; margin-top:6px; }
.section-head { display:flex; justify-content:space-between; align-items:center; gap:14px; margin-bottom:16px; }
.section-head h2, .section-head h3 { margin:0; font-size:16px; letter-spacing:-.03em; }
.section-head p { margin:4px 0 0; color:var(--muted); font-size:12px; }
.search-row { display:flex; gap:10px; }
.karaoke-option { display:flex; align-items:center; gap:8px; margin-top:10px; color:var(--muted); font-size:12px; }
.karaoke-option input { accent-color:var(--teal); }
.search-row .input { flex:1; }
.results { display:grid; gap:12px; margin-top:18px; }
.result { display:grid; grid-template-columns:125px minmax(0,1fr) auto; gap:14px; align-items:center; width:100%; min-width:0; overflow:hidden; padding:12px; border:1px solid var(--line); border-radius:14px; background:#fff; }
.result img { width:125px; height:70px; flex:0 0 125px; border-radius:10px; object-fit:cover; background:#dbe9f2; }
.result-copy { min-width:0; overflow:hidden; }
.result-title { display:block; color:var(--ink); text-decoration:none; font-weight:800; font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.result-title:hover { color:var(--teal); text-decoration:underline; }
.result-meta { color:var(--muted); font-size:12px; margin-top:5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.result .add-song { flex:0 0 auto; min-width:52px; justify-self:end; white-space:nowrap; }
.list { display:grid; gap:10px; }
.song-row { display:flex; align-items:center; gap:12px; width:100%; min-width:0; overflow:hidden; padding:13px 0; border-bottom:1px solid #edf1f5; }
.song-row:last-child { border-bottom:0; }
.song-rank { flex:0 0 28px; width:28px; text-align:center; color:var(--muted); font-weight:800; font-size:12px; }
.song-thumb { flex:0 0 54px; width:54px; height:34px; border-radius:7px; object-fit:cover; background:#e6eef5; }
.song-main { flex:1 1 auto; width:0; min-width:0; overflow:hidden; }
.song-title { font-size:13px; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.song-title.is-link { display:block; color:var(--ink); text-decoration:none; }
.song-title.is-link:hover { color:var(--teal); text-decoration:underline; }
.song-meta { font-size:11px; color:var(--muted); margin-top:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.song-row .remove-own { flex:0 0 auto; margin-left:auto; white-space:nowrap; }
.own-actions { display:flex; align-items:center; gap:4px; flex:0 0 auto; margin-left:auto; }
.own-actions .remove-own { margin-left:0; }
.own-actions .move-own { padding:5px 7px; font-size:12px; line-height:1; }
.own-actions .move-own:disabled { opacity:.35; }
.queue-current { background:rgba(25,167,160,.08); }
.current-rank { color:var(--teal); }
.queue-playing-icon { color:var(--teal); font-size:13px; font-weight:900; text-align:center; }
.tag { display:inline-flex; align-items:center; border-radius:99px; padding:4px 8px; font-size:10px; font-weight:800; background:#eef4f8; color:var(--muted); }
.tag.pin { color:#9c7112; background:#fff7df; }
.empty { padding:34px 15px; text-align:center; color:var(--muted); font-size:13px; }
.notice { border-radius:14px; padding:13px 15px; background:#fff8df; color:#8e6b1c; font-size:13px; line-height:1.5; overflow-wrap:anywhere; }
.login-wrap { min-height:100vh; display:grid; place-items:center; padding:24px; background: radial-gradient(circle at 20% 10%, #d8f1ef, transparent 35%), var(--paper); }
.login-card { width:min(460px,100%); padding:34px; }
.login-card h1 { font-size:31px; letter-spacing:-.06em; margin:11px 0 10px; }
.login-card p { color:var(--muted); font-size:13px; line-height:1.7; margin:0 0 25px; }
.login-card form { display:grid; gap:13px; }
.helper { color:var(--muted); font-size:11px; line-height:1.6; }
.admin-layout { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(330px,.85fr); gap:18px; align-items:start; }
.queue-table { display:grid; gap:0; }
.queue-item { display:flex; align-items:center; gap:8px; width:100%; min-width:0; overflow:hidden; padding:13px 0; border-bottom:1px solid #edf1f5; text-align:left; }
.queue-item:last-child { border-bottom:0; }
.drag { flex:0 0 26px; width:26px; color:#9fb3c8; cursor:grab; font-size:16px; }
.queue-item .song-rank { flex:0 0 44px; width:44px;  }
.queue-actions { order:3; display:flex; flex:0 0 148px; width:148px; min-width:0; gap:5px; flex-wrap:nowrap; justify-content:flex-start; white-space:nowrap; overflow:hidden; }
.queue-actions .btn { white-space:nowrap; }
/* 已置顶：按钮本身变成琥珀色实心，行左侧加一道色条，
   一眼能看出"这首已经被置顶了"，不用再额外挂徽章。 */
.btn.pin-on { background:#f0b429; color:#3d2b00; box-shadow:0 4px 10px rgba(240,180,41,.28); }
.btn.pin-on:hover { background:#e2a614; }
.queue-item.is-pinned { background:linear-gradient(90deg,rgba(240,180,41,.10),transparent 60%); }
.queue-item.is-pinned .song-rank { color:#9c7112; font-weight:800; }
html[data-theme="night"] .btn.pin-on { background:#f0b429; color:#241a00; }
.queue-item .song-thumb { order:4; }
.queue-item .song-main { order:5; flex:1 1 auto; width:0; min-width:0; overflow:hidden; padding-left:12px; text-align:left; }
.queue-item .song-title, .queue-item .song-meta { text-align:left; }
.queue-item.queue-current .drag { visibility:hidden; }
.queue-item.queue-current .song-main { padding-left:12px; }
.queue-actions-placeholder { visibility:hidden; pointer-events:none; }
.control-strip { display:flex; gap:9px; flex-wrap:wrap; }
.control-strip .playback[data-action="skip"] { margin-left:auto; }
.playback.armed { background:#b83c3c; color:#fff; box-shadow:0 0 0 3px rgba(217,79,79,.18); }
.volume { display:flex; align-items:center; gap:10px; min-width:180px; }
.volume input { accent-color:var(--teal); flex:1; }
.broadcast { display:flex; gap:9px; }
.broadcast .input { flex:1; }
.important-choice { display:flex; align-items:center; gap:8px; margin-top:12px; color:#9c7112; }
.important-state { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:12px; padding-top:12px; border-top:1px solid #f0e6c6; }
.btn.important-toggle { width:100%; background:#d94f4f; color:#fff; box-shadow:0 8px 18px rgba(217,79,79,.24); }
.btn.important-toggle:hover { background:#bf3e3e; }
.btn.important-toggle:disabled { opacity:.65; cursor:not-allowed; transform:none; }
.settings-modal-backdrop { position:fixed; inset:0; z-index:40; display:none; place-items:center; padding:24px; background:rgba(7,19,31,.42); backdrop-filter:blur(6px); }
.settings-modal-backdrop.open { display:grid; }
.settings-modal { width:min(560px, 100%); max-height:calc(100vh - 48px); overflow-y:auto; overscroll-behavior:contain; padding:24px; }
.settings-modal .section-head { align-items:flex-start; }
.filter-block, .timing-block { margin-top:16px; padding-top:14px; border-top:1px solid rgba(127,150,170,.25); }
.filter-block { display:grid; gap:11px; }
.toggle-row { display:flex; align-items:flex-start; gap:9px; color:var(--ink); font-size:13px; cursor:pointer; }
.toggle-row input { margin-top:2px; accent-color:var(--teal); }
.toggle-row span { display:grid; gap:3px; }
.toggle-row small { color:var(--muted); font-size:11px; line-height:1.4; }
.filter-block textarea { resize:vertical; min-height:54px; }
.timing-block .eyebrow { color:var(--muted); font-size:11px; letter-spacing:.12em; text-transform:uppercase; margin-bottom:4px; }
.timing-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); gap:10px 12px; margin-top:10px; }
.timing-grid .field { gap:5px; }
.timing-grid .input { padding:9px 10px; }
.timing-warning { margin:9px 0 0; color:#b26b00; line-height:1.5; }
.timing-warning[hidden] { display:none; }
.user-row { display:flex; align-items:center; gap:11px; padding:11px 0; border-bottom:1px solid #edf1f5; }
.avatar { width:32px; height:32px; border-radius:50%; display:grid; place-items:center; background:#d9f1ef; color:#147d78; font-weight:800; }
.user-copy { min-width:0; flex:1; }
.user-name { font-weight:800; font-size:13px; }
.user-meta { color:var(--muted); font-size:11px; margin-top:3px; }
.user-row .block-guest { flex:0 0 auto; margin-left:4px; }
.blocked-guests-list { display:grid; gap:8px; }
.blocked-guest-row { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:11px 0; border-bottom:1px solid #edf1f5; }
.blocked-guest-row:last-child { border-bottom:0; }
.blocked-guest-row > div { min-width:0; display:grid; gap:3px; }
.blocked-guest-row strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.blocked-guest-row small { color:var(--muted); font-size:11px; }
.display-page { min-height:100vh; color:#fff; background:#07131f; overflow:hidden; }
/* 大屏下播放页是**定高**的：display-main 必须有确定的 height，否则
   flex:1 的播放器会按内容撑高（歌词多高就多高），把整页顶出视口。 */
.display-shell { height:100vh; display:grid; grid-template-columns:minmax(0, 1.65fr) minmax(330px, .55fr); grid-template-rows:minmax(0, 1fr); gap:18px; padding:24px; overflow:hidden; }
.display-main { height:100%; min-height:0; display:flex; flex-direction:column; gap:16px; overflow:hidden; }
.display-brand { display:flex; align-items:center; justify-content:space-between; }
.display-brand .brand { color:#fff; }
.live-dot { display:inline-flex; align-items:center; gap:7px; font-size:11px; color:#a7bbcc; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
.live-dot i { width:7px; height:7px; border-radius:50%; background:#2dd4bf; box-shadow:0 0 14px #2dd4bf; }
.player-frame { flex:1; min-height:0; background:#000; border-radius:18px; overflow:hidden; display:grid; place-items:center; border:1px solid rgba(255,255,255,.08); }
.player-frame iframe { width:100%; height:100%; min-height:420px; border:0; }
.display-idle { text-align:center; padding:35px; }
.display-idle .big-note { font-size:clamp(24px,4vw,56px); font-weight:800; letter-spacing:-.06em; margin:18px 0 8px; }
.display-idle p { color:#94a9ba; margin:0; }
/* 下一首还在后台制作：待机画面 + 一条循环进度条，明确"在处理，不是卡住" */
.display-idle.display-preparing p + p { margin-top:6px; font-size:12px; }
.preparing-bar {
  width:min(240px, 60%);
  height:4px;
  margin:22px auto 0;
  border-radius:999px;
  overflow:hidden;
  background:rgba(255,255,255,.12);
}
.preparing-bar i {
  display:block;
  width:40%;
  height:100%;
  border-radius:999px;
  background:linear-gradient(90deg,#2dd4bf,#4de3d6);
  animation:preparing-slide 1.35s ease-in-out infinite;
}
@keyframes preparing-slide {
  0% { transform:translateX(-105%); }
  100% { transform:translateX(255%); }
}
.broadcast-banner { background:#143347; border-radius:14px; padding:14px 18px; color:#d9f8f5; min-height:49px; display:flex; align-items:center; gap:10px; }
.broadcast-banner span { min-width:0; flex:1; overflow-wrap:anywhere; }
.broadcast-banner strong { color:#4de3d6; font-size:11px; letter-spacing:.1em; }
.display-side { background:#0d2031; border:1px solid rgba(255,255,255,.08); border-radius:18px; padding:23px; display:flex; flex-direction:column; min-height:0; height:100%; overflow:hidden; }
.display-side h1 { margin:5px 0 4px; font-size:25px; letter-spacing:-.06em; }
.display-side p { color:#8ea3b7; font-size:12px; margin:0; }
.qr-box { margin:24px auto 21px; background:white; padding:10px; border-radius:12px; width:180px; height:180px; }
.qr-box img { width:100%; height:100%; display:block; }
.display-side .side-title { color:#8ea3b7; font-size:11px; text-transform:uppercase; letter-spacing:.13em; font-weight:800; margin-bottom:9px; }
.display-queue { flex:1; overflow:auto; }
.display-song { display:flex; gap:10px; min-width:0; padding:13px 0; border-bottom:1px solid rgba(255,255,255,.08); }
.display-song .number { color:#4de3d6; width:19px; font-weight:800; }
.display-song.queue-current { background:rgba(77,227,214,.07); }
.display-song.queue-current .current-rank { color:#4de3d6; font-size:13px; }
.display-song .copy { min-width:0; }
.display-song .title { font-size:13px; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.display-song .meta { color:#8ea3b7; font-size:11px; margin-top:4px; }

.drinks-card { margin-top:14px; flex:0 0 auto; display:flex; flex-direction:column; background:rgba(77,227,214,.07); border:1px solid rgba(77,227,214,.28); border-radius:14px; overflow:hidden; transition:opacity .55s ease, transform .55s ease; }
.drinks-card[hidden] { display:none; }
.drinks-card.is-hidden { opacity:0; transform:translateY(8px); pointer-events:none; }
.drinks-head { flex:0 0 auto; display:flex; justify-content:space-between; align-items:center; padding:9px 14px; font-size:10px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; color:#4de3d6; border-bottom:1px solid rgba(255,255,255,.09); }
.drinks-viewport { flex:1; min-height:0; overflow:hidden; padding:8px 14px 11px; }
.drinks-track { display:grid; grid-template-columns:1fr 1fr; column-gap:20px; row-gap:5px; will-change:transform; }
.drink-item { display:flex; align-items:baseline; gap:6px; min-width:0; font-size:12.5px; }
.drink-name { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:#eaf7ff; }
.drink-dots { flex:1; min-width:8px; border-bottom:1px dotted rgba(142,163,183,.5); transform:translateY(-3px); }
.drink-price { color:#4de3d6; font-weight:800; white-space:nowrap; }
@keyframes drinksScroll { from { transform:translateY(0); } to { transform:translateY(var(--drinks-distance, 0px)); } }

.display-origin-warning { background:#4a3300; border:1px solid #8a6a00; color:#ffd98a; padding:10px 14px; border-radius:10px; font-size:12.5px; line-height:1.5; }
.display-origin-warning a { color:#ffd98a; text-decoration:underline; }
.broadcast-banner { transition:opacity .45s ease; }
.broadcast-banner.banner-fade { opacity:0; }

.animation-layer { position:fixed; inset:0; z-index:26; pointer-events:none; overflow:hidden; opacity:0; transition:opacity .45s ease; }
.animation-layer.visible { opacity:1; }
.animation-particle { position:absolute; top:-10vh; line-height:1; animation-name:particleFall; animation-timing-function:linear; animation-iteration-count:infinite; filter:drop-shadow(0 0 8px rgba(255,255,255,.25)); }
.animation-layer.hearts .animation-particle { top:auto; bottom:-10vh; animation-name:particleRise; }
.animation-layer.sparkles .animation-particle { top:auto; animation-name:particleTwinkle; animation-timing-function:ease-in-out; }
.animation-layer.disco .animation-particle { animation-name:particleSpin; }
.animation-layer.balloons .animation-particle { top:auto; bottom:-16vh; animation-name:balloonRise; animation-timing-function:ease-in-out; filter:drop-shadow(0 0 12px rgba(255,123,181,.42)); }
.animation-layer.petals .animation-particle { animation-name:petalFall; animation-timing-function:ease-in-out; filter:drop-shadow(0 0 8px rgba(255,170,211,.38)); }
.animation-layer.bubbles .animation-particle { top:auto; bottom:-10vh; width:26px; height:26px; font-size:0 !important; border:1px solid rgba(161,239,255,.85); border-radius:50%; background:radial-gradient(circle at 30% 25%, rgba(255,255,255,.9) 0 8%, rgba(143,230,255,.22) 28%, rgba(74,183,255,.08) 68%, transparent 70%); box-shadow:inset -4px -5px 9px rgba(74,183,255,.2), 0 0 16px rgba(93,217,255,.42); animation-name:bubbleRise; animation-timing-function:ease-in-out; }
.animation-layer.neon .animation-particle { top:auto; width:clamp(24px, 4vw, 58px); height:clamp(24px, 4vw, 58px); font-size:0 !important; border:2px solid #4de3d6; border-radius:50%; box-shadow:0 0 8px #4de3d6, 0 0 28px rgba(77,227,214,.7), inset 0 0 12px rgba(77,227,214,.55); animation-name:neonPulse; animation-timing-function:ease-in-out; }
.animation-layer.neon .animation-particle:nth-child(3n) { border-color:#ff6fba; box-shadow:0 0 8px #ff6fba, 0 0 28px rgba(255,111,186,.62), inset 0 0 12px rgba(255,111,186,.5); }
.animation-layer.neon .animation-particle:nth-child(3n + 1) { border-color:#ffe27a; box-shadow:0 0 8px #ffe27a, 0 0 28px rgba(255,226,122,.62), inset 0 0 12px rgba(255,226,122,.5); }
.animation-layer.aurora .animation-particle { top:18%; width:52vw; height:18vw; font-size:0 !important; border-radius:50%; background:linear-gradient(115deg, rgba(77,227,214,.05), rgba(77,227,214,.42), rgba(149,111,255,.32), rgba(255,111,186,.2), transparent 72%); filter:blur(24px); opacity:.75; animation-name:auroraDrift; animation-timing-function:ease-in-out; }
.animation-layer.aurora .animation-particle:nth-child(2n) { top:42%; height:13vw; background:linear-gradient(115deg, transparent, rgba(74,183,255,.34), rgba(153,117,255,.38), rgba(77,227,214,.16), transparent 75%); animation-duration:6s; }
.animation-layer.shootingStars .animation-particle { top:30%; width:150px; height:2px; font-size:0 !important; border-radius:99px; background:linear-gradient(90deg, transparent, rgba(255,255,255,.95) 35%, #4de3d6 72%, transparent); box-shadow:0 0 8px #fff, 0 0 20px rgba(77,227,214,.85); transform:rotate(-28deg); animation-name:shootingStar; animation-timing-function:ease-out; }
@keyframes particleFall { 0% { transform:translateY(-10vh) rotate(0deg); opacity:1; } 100% { transform:translateY(115vh) rotate(240deg); opacity:.15; } }
@keyframes particleRise { 0% { transform:translateY(10vh) scale(.7); opacity:0; } 20% { opacity:1; } 100% { transform:translateY(-115vh) scale(1.15); opacity:0; } }
@keyframes particleTwinkle { 0%, 100% { opacity:0; transform:scale(.5); } 40%, 60% { opacity:1; transform:scale(1.1); } }
@keyframes particleSpin { 0% { transform:translateY(-10vh) rotate(0deg); opacity:0; } 15% { opacity:1; } 100% { transform:translateY(100vh) rotate(540deg); opacity:0; } }
@keyframes balloonRise { 0% { transform:translate3d(0, 12vh, 0) rotate(-8deg) scale(.72); opacity:0; } 16% { opacity:1; } 50% { transform:translate3d(32px, -48vh, 0) rotate(8deg) scale(1); } 100% { transform:translate3d(-26px, -125vh, 0) rotate(-7deg) scale(1.08); opacity:0; } }
@keyframes petalFall { 0% { transform:translate3d(0, -12vh, 0) rotate(0deg) scale(.8); opacity:0; } 12% { opacity:1; } 50% { transform:translate3d(42px, 54vh, 0) rotate(170deg) scale(1); } 100% { transform:translate3d(-38px, 120vh, 0) rotate(360deg) scale(.9); opacity:0; } }
@keyframes bubbleRise { 0% { transform:translate3d(0, 12vh, 0) scale(.55); opacity:0; } 16% { opacity:.9; } 55% { transform:translate3d(-28px, -48vh, 0) scale(1.05); } 100% { transform:translate3d(34px, -125vh, 0) scale(.82); opacity:0; } }
@keyframes neonPulse { 0%, 100% { transform:translateY(12vh) scale(.55); opacity:0; } 22%, 72% { opacity:.9; } 50% { transform:translateY(-35vh) scale(1.08); } }
@keyframes auroraDrift { 0%, 100% { transform:translate3d(-10vw, -10vh, 0) rotate(-8deg) scale(.8); opacity:0; } 18% { opacity:.72; } 50% { transform:translate3d(18vw, 12vh, 0) rotate(7deg) scale(1.08); opacity:.86; } 82% { opacity:.55; } }
@keyframes shootingStar { 0% { transform:translate3d(-18vw, -8vh, 0) rotate(-28deg) scaleX(.4); opacity:0; } 12% { opacity:1; } 100% { transform:translate3d(115vw, 72vh, 0) rotate(-28deg) scaleX(1.1); opacity:0; } }

.drinks-editor-rows { display:grid; gap:8px; margin-bottom:10px; }
.drink-edit-row { display:grid; grid-template-columns:1fr 92px 36px; gap:8px; }
.drink-edit-row .input { padding:8px 10px; }
.drinks-editor-actions { display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
.drinks-editor-actions .helper { margin:0; }
.drinks-editor-actions input[type="number"] { width:74px; padding:7px 9px; margin-left:6px; }
.animation-buttons { display:flex; flex-wrap:wrap; gap:8px; }
.broadcast-list { display:flex; flex-wrap:wrap; align-content:flex-start; gap:6px; margin-top:12px; max-height:190px; overflow:auto; }
.broadcast-list .empty { width:100%; }
.broadcast-item { display:inline-flex; align-items:center; gap:3px; max-width:100%; padding:4px 5px 4px 10px; border-radius:8px; background:rgba(255,255,255,.06); font-size:12.5px; }
.broadcast-item span { min-width:0; max-width:230px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.broadcast-item button { flex:0 0 auto; border:0; background:transparent; color:#ff938c; font-size:15px; line-height:1; padding:0 2px; cursor:pointer; }
.display-footer { margin-top:20px; padding-top:18px; border-top:1px solid rgba(255,255,255,.08); color:#8ea3b7; font-size:11px; line-height:1.6; display:flex; align-items:flex-end; justify-content:space-between; gap:12px; }
.display-footer [data-role="display-footer-copy"] { min-width:0; flex:1; }
.display-footer .btn { flex:0 0 auto; width:34px; height:32px; padding:7px; }
.display-footer .fullscreen-icon { width:17px; height:17px; display:block; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
.important-overlay { position:fixed; inset:0; z-index:30; display:none; place-items:center; padding:28px; background:rgba(5, 15, 25, .26); backdrop-filter:blur(14px); text-align:center; }
.important-overlay.visible { display:grid; }
.important-card { width:min(760px, 92vw); padding:48px 30px; border:1px solid rgba(77,227,214,.24); border-radius:24px; background:linear-gradient(145deg, rgba(20,51,71,.98), rgba(7,19,31,.98)); box-shadow:0 30px 90px rgba(0,0,0,.35); }
.important-kicker { color:#4de3d6; font-size:12px; font-weight:800; letter-spacing:.22em; }
.speaker-icon { display:grid; place-items:center; margin:0 auto 24px; }
.speaker-icon svg { width:clamp(110px, 18vw, 210px); height:clamp(110px, 18vw, 210px); fill:none; stroke:#4de3d6; stroke-width:7; stroke-linecap:round; stroke-linejoin:round; filter:drop-shadow(0 0 24px rgba(77,227,214,.28)); }
.countdown-speaker svg { stroke:#f4c95d; filter:drop-shadow(0 0 24px rgba(244,201,93,.24)); }
.important-title { margin-top:14px; color:#fff; font-size:clamp(32px, 6vw, 76px); font-weight:800; letter-spacing:-.07em; }
.important-message { margin:22px auto 0; color:#e8fbf9; font-size:clamp(20px, 3vw, 36px); font-weight:700; line-height:1.35; max-width:700px; }
.important-subtitle { margin-top:20px; color:#9fb8c8; font-size:14px; }
.important-countdown { margin:18px 0 0; color:#f4c95d; font-size:clamp(70px, 12vw, 150px); line-height:.9; font-weight:800; letter-spacing:-.08em; }
.toast { position:fixed; left:50%; bottom:24px; transform:translate(-50%, 20px); opacity:0; pointer-events:none; z-index:50; background:#102a43; color:white; border-radius:10px; padding:12px 16px; font-size:13px; box-shadow:0 12px 30px rgba(0,0,0,.2); transition:all .2s; }
.toast.show { opacity:1; transform:translate(-50%, 0); }
.muted { color:var(--muted); }
@media (max-width: 900px) { .grid.two, .admin-layout, .display-shell { grid-template-columns:1fr; } .display-side { min-height:auto; } .display-main { min-height:auto; } .player-frame iframe { min-height:50vh; } .stat-row { grid-template-columns:repeat(2,1fr); }
  /* 窄屏要能滚动：解锁大屏的定高 */
  .display-page { overflow:auto; }
  .display-shell { height:auto; min-height:100vh; grid-template-rows:auto; overflow:visible; }
  .display-main { height:auto; overflow:visible; }
  .display-side { height:auto; overflow:visible; }
  .player-frame { min-height:52vh; }
}
@media (max-width: 560px) { .page { width:min(92vw, 520px); padding-top:25px; } .topbar { padding:0 4vw; } .hero { display:block; } .hero .btn { margin-top:18px; } .panel { padding:17px; } .settings-modal { padding:18px; } .timing-grid { grid-template-columns:1fr; } .result { grid-template-columns:88px minmax(0,1fr) auto; gap:9px; } .result img { width:88px; height:52px; } .result .btn { padding:9px; } .queue-item { gap:6px; } .queue-item .drag { flex:0 0 20px; width:20px; } .queue-item .song-rank { flex:0 0 32px; width:32px; } .queue-item .song-thumb { width:42px; height:28px; flex:0 0 42px; } .queue-item .song-main { padding-left:8px; } .queue-actions { flex:0 0 116px; width:116px; justify-content:center; } .queue-actions .btn { padding:7px 8px; font-size:11px; } .stat .value { font-size:25px; } .display-shell { padding:12px; } .display-side { padding:18px; } .broadcast { display:grid; } }


/* 本地曲目标记（模式 B） */
.result-badge {
  display: inline-block;
  margin-left: 8px;
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  vertical-align: middle;
  background: rgba(45, 212, 191, .18);
  color: #2dd4bf;
}

/* ============================================================
   本地曲库播放：人声强度胶囊（模式 B）
   外观对齐 /lyrics-preview.html 的预览工具条：毛玻璃、opacity .28、hover 1。
   只在 source === 'local' 时由 app.js 挂到 #player 里；YouTube 音轨拆不开，不显示。
   ============================================================ */
#player { position: relative; }
.vocal-control {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%) translateY(10px);
  z-index: 20;
  display: flex;
  gap: 8px;
  align-items: center;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(12, 12, 14, .72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 255, 255, .12);
  font: 500 12px/1 'Manrope', 'Noto Sans SC', system-ui, sans-serif;
  color: rgba(255, 255, 255, .82);
  /* 沉浸模式：默认完全隐藏，鼠标一动才出现（见 app.js 的 wakeUI） */
  opacity: 0;
  pointer-events: none;
  transition: opacity .28s ease, transform .28s cubic-bezier(.16,1,.3,1);
  max-width: calc(100% - 24px);
  box-sizing: border-box;
}
#player.ui-awake .vocal-control {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

/* 视频模式：工具栏挂在 .vlm-vocal-slot 里（绝对定位居中），
   **必须**在被 MV iframe 覆盖时仍能点到 —— 沉浸模式只控制显隐，
   不允许把 pointer-events 关掉，否则"逐字/逐行点了没反应"。
   同时把过渡限制在 opacity/transform 上，避免位置上的抖动。 */
.vlm-vocal-slot .vocal-control {
  pointer-events: auto;
}
#player:not(.ui-awake) .vlm-vocal-slot .vocal-control {
  opacity: 0;
  pointer-events: none;   /* 沉浸时彻底让开，不要挡住视频点击 */
}
#player.ui-awake .vlm-vocal-slot .vocal-control {
  opacity: 1;
  pointer-events: auto;
}
/* 鼠标停在胶囊上时保持可见，避免调音量时突然消失 */
.vocal-control:hover,
.vocal-control:focus-within { opacity: 1; }
.vocal-control-label { opacity: .6; padding-right: 2px; }
.vocal-control-range { width: 130px; accent-color: #fff; }
.vocal-control-value { min-width: 40px; opacity: .85; font-variant-numeric: tabular-nums; white-space: nowrap; }
.vocal-control-sep { width: 1px; align-self: stretch; background: rgba(255, 255, 255, .14); margin: 2px 2px; }
/* 自动播放被浏览器拒绝时的提示层（盖在播放区上，点一下就恢复） */
.autoplay-hint {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  border: 0;
  cursor: pointer;
  background: rgba(0, 0, 0, .62);
  backdrop-filter: blur(2px);
  color: #fff;
  font: 700 clamp(16px, 1.6vw, 22px)/1.3 'Manrope', 'Noto Sans SC', system-ui, sans-serif;
  letter-spacing: .02em;
}
.autoplay-hint:hover { background: rgba(0, 0, 0, .55); }
.autoplay-hint-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 24px;
  padding-left: 4px;
  background: rgba(255, 255, 255, .14);
  border: 1px solid rgba(255, 255, 255, .28);
}
/* DJ 控制台的人声混合条 */
.vocal-mix {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px dashed #e3ebf2;
}
.vocal-mix > input[type="range"] { width: 180px; accent-color: #2dd4bf; }
.vocal-mix > b { min-width: 42px; font-variant-numeric: tabular-nums; }
.vocal-mix-presets { display: flex; gap: 6px; }
.vocal-mix .helper { flex-basis: 100%; margin: 0; }
.vocal-mix .vocal-preset.on { background: #2dd4bf; color: #06251f; border-color: transparent; }

/* 播放控制区下面的附加行（目前只有「视频歌词」开关）。
   不放进 .vocal-mix，因为那一行在「没有当前歌曲」时整行隐藏，
   而视频歌词开关应该在设置里选了视频画面时一直可用。 */
.playback-extras {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px dashed #e3ebf2;
}
.playback-extras[hidden] { display: none; }
.extra-label { color: #6b7c8c; font-size: 12px; font-weight: 600; }
.playback-extras .vocal-preset.on { background: #2dd4bf; color: #06251f; border-color: transparent; }
/* 这首歌没有逐字数据时，「歌词逐字」按钮置灰（仍可点，只是不会有可见变化） */
.vocal-mix .vocal-preset.unavailable { opacity: .42; }
/* 人声预设 与 歌词/视频歌词开关之间的细分隔线 */
.vocal-mix-sep {
  width: 1px;
  align-self: stretch;
  margin: 2px 4px;
  background: #e3ebf2;
}

.vocal-control-preset {
  border: 1px solid rgba(255, 255, 255, .18);
  background: rgba(255, 255, 255, .08);
  color: inherit;
  font: inherit;
  padding: 7px 11px;
  border-radius: 999px;
  cursor: pointer;
  white-space: nowrap;
}
.vocal-control-preset:hover { background: rgba(255, 255, 255, .16); }
.vocal-control-preset.on { background: rgba(255, 255, 255, .9); color: #111; }

/* ---- 队列项制作状态（模式 B：准备中 / 已就绪 / 准备失败）---- */
/* 队列状态徽标：横向留够间距、和文字基线对齐，别贴在歌名/频道后面 */
.queue-status { display:inline-flex; align-items:center; border-radius:99px; padding:2px 8px; margin-left:8px; font-size:10px; font-weight:800; letter-spacing:.02em; background:#eef4f8; color:#52606d; white-space:nowrap; vertical-align:1px; }
.queue-status.preparing { background:#fff4e0; color:#a35a00; }
.queue-status.preparing::before { content:""; width:6px; height:6px; border-radius:50%; background:#e08a00; margin-right:5px; animation:queuePulse 1.2s ease-in-out infinite; }
.queue-status.ready { background:#e3f8f0; color:#0b7a5a; }
.queue-status.failed { background:#fdecec; color:#b42318; }
@keyframes queuePulse { 0%,100% { opacity:1; } 50% { opacity:.25; } }
.song-row.is-preparing { background:linear-gradient(90deg,rgba(255,244,224,.55),transparent 60%); }
.song-row.is-failed { background:linear-gradient(90deg,rgba(253,236,236,.6),transparent 60%); }
.song-failed-note { color:#b42318; font-size:11px; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* ---- DJ 控制台标签页 ---- */
.admin-tabs { display:flex; gap:8px; margin:0 0 16px; border-bottom:1px solid #e4eae1; }
.admin-tab { border:0; background:transparent; padding:10px 16px; font:inherit; font-weight:800; font-size:13px; color:var(--muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
.admin-tab:hover { color:inherit; }
.admin-tab.active { color:var(--ink,#102a43); border-bottom-color:#0b7a5a; }

/* ---- 曲库管理 ---- */
/* 曲库页要放 9 列（含新增的「MV」列）和 3~4 个操作按钮。
   曲目列是唯一弹性列，min 压到 150px 收窄曲目栏；
   操作列固定 264px 并禁止换行，MV / 改词重搜 / 删除（制作中还有「停止」）
   永远排在一排（按钮左右内边距压到 9px 保证放得下）。
   窗口不够宽时按断点逐级折叠（操作列换到下一行占满）。 */
.page.compact.library-page { width: min(1600px, 96vw); }
.lib-table { display:grid; gap:0; }
/* 列：封面 | 曲目(弹性) | 状态 | 歌词 | 官方 MV | 耗时 | 大小 | 匹配分 | 操作 */
.lib-row { display:grid; grid-template-columns:52px minmax(150px,1fr) 108px 92px 190px 78px 70px 64px 264px; gap:12px; align-items:center; padding:10px 0; border-bottom:1px solid #edf1f5; font-size:13px; }
.lib-row:last-child { border-bottom:0; }
.lib-row.lib-head { font-size:11px; font-weight:800; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; padding:6px 0; }
.lib-row .song-thumb { width:44px; height:44px; }
/* .song-main 默认是 width:0 + flex:1（给 flex 行用的）。曲库表格是 CSS Grid，
   网格单元格里 width:0 会真的压成 0 宽，歌名/歌手/专辑全看不见。
   这里必须还原宽度，否则整列空白。 */
.lib-row .song-main { width:auto; flex:none; min-width:0; }
.lib-row .song-title, .lib-row .song-meta { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.lib-panel { padding:20px; }
.lib-cancel, .lib-remove, .lib-lyrics, .lib-mv { white-space:nowrap; }
/* 歌词状态徽标 */
.lib-badge-ok { background:rgba(45,212,191,.16); color:#0d9488; }
.lib-badge-warn { background:rgba(245,158,11,.16); color:#b45309; }
/* 「改词重搜」弹窗的结果区要能换行（默认 notice 是单行省略） */
#lr-result { white-space:pre-wrap; line-height:1.55; }
/* 操作列的按钮必须排成一排：nowrap + 左右内边距压到 9px，
   264px 列宽足够放下「停止 MV 改词重搜 删除」四个按钮。 */
.lib-row .queue-actions { display:flex; gap:6px; flex-wrap:nowrap; justify-content:flex-end; }
.lib-row .queue-actions .btn { flex:0 0 auto; padding-left:9px; padding-right:9px; }
.lib-row.lib-processing { background:linear-gradient(90deg,rgba(255,244,224,.55),transparent 70%); }
.lib-status-cell { display:flex; flex-direction:column; gap:3px; }
.lib-badge { display:inline-flex; align-items:center; width:max-content; border-radius:99px; padding:3px 9px; font-size:11px; font-weight:800; background:#eef4f8; color:#52606d; white-space:nowrap; }
.lib-badge.lib-processed { background:#e3f8f0; color:#0b7a5a; }
.lib-badge.lib-processing { background:#fff4e0; color:#a35a00; }
.lib-badge.lib-failed { background:#fdecec; color:#b42318; }
.lib-error { color:#b42318; }
/* 中等窗口：把"大小/匹配分"让给操作列和曲目列，其余继续同排 */
@media (max-width:1400px) {
  .lib-row { grid-template-columns:48px minmax(130px,1fr) 100px 86px 170px 72px 0 0 250px; gap:10px; }
  .lib-row > :nth-child(7), .lib-row > :nth-child(8) { display:none; } /* 大小 / 匹配分 */
}
/* 窄窗口：操作列整行放到最下面，按钮不会再把内容挤没 */
@media (max-width:1100px) {
  .lib-row { grid-template-columns:44px minmax(150px,1fr) 96px 84px 160px; gap:10px; }
  .lib-row > :nth-child(6), .lib-row > :nth-child(7), .lib-row > :nth-child(8) { display:none; } /* 耗时 / 大小 / 匹配分 */
  .lib-row > :last-child { grid-column:1 / -1; justify-content:flex-start; padding-top:2px; }
}

/* ---- 官方 MV 弹窗 ---- */
/* 弹窗本身限高；候选列表自己有滚动，所以弹窗不会再被 8 条候选撑得很长 */
#mv-dialog .settings-modal { max-width:820px; max-height:86vh; overflow-y:auto; }
#mv-dialog .mv-current .song-meta { white-space:normal; }
.mv-current { border:1px solid var(--line); border-radius:10px; padding:12px 14px; background:var(--paper); margin-bottom:12px; }
.mv-current-head { display:flex; align-items:center; gap:10px; margin-bottom:8px; }
.mv-line { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; font-size:13px; }
.mv-line a { color:var(--accent,#0d9488); font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12px; }
.mv-reason { white-space:pre-wrap; line-height:1.5; margin-top:6px; }
.mv-actions { display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; }
.mv-manual { display:flex; gap:8px; align-items:flex-end; margin-bottom:14px; }
.mv-manual .field { flex:1; margin:0; }
/* ---- 候选列表：紧凑行 + 固定高度可滚动 ----
   以前每条候选把"评分明细"整段铺开，8 条候选把弹窗撑得极高、还很乱。
   现在：单行高度 ~56px，标题一行省略、明细收进 tooltip（悬停看），
   整个列表限高滚动，弹窗高度稳定。 */
.mv-candidates .section-head { margin-bottom:6px; }
.mv-candidates .section-head h3 { font-size:14px; margin:0; }
.mv-candidates .section-head .helper { margin:2px 0 0; font-size:11px; }
.mv-list { max-height:min(42vh, 340px); overflow-y:auto; overscroll-behavior:contain; border:1px solid var(--line); border-radius:10px; padding:0 10px; background:var(--paper); }
.mv-candidate { display:grid; grid-template-columns:64px minmax(0,1fr) auto; gap:10px; align-items:center; padding:7px 0; border-bottom:1px solid var(--line); }
.mv-candidate:last-child { border-bottom:0; }
.mv-candidate .song-thumb { width:64px; height:36px; border-radius:6px; object-fit:cover; }
.mv-candidate.is-current { background:rgba(45,212,191,.08); }
.mv-candidate .song-main { min-width:0; }
.mv-candidate .song-title { max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:13px; }
.mv-candidate .song-meta { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:11px; }
.mv-candidate .queue-actions { display:flex; gap:6px; flex-wrap:nowrap; }
.mv-score { display:inline-block; min-width:34px; text-align:right; font-variant-numeric:tabular-nums; font-weight:800; }

/* ---- 曲库页：一键匹配 MV / 歌词 ---- */
/* search-row 是 stretch 对齐（输入框比 .btn 高几像素），这里也用 stretch，
   匹配/补测按钮才和同排「刷新/清理残留」完全等高；纯文本子项手动居中。 */
.lib-match { display:flex; align-items:stretch; gap:10px; flex-wrap:wrap; margin:0 0 10px; }
.lib-match .song-meta, .lib-match .lib-match-text { align-self:center; }
.lib-match .lib-match-bar { flex:1 1 160px; height:6px; min-width:120px; border-radius:99px; background:#eef4f8; overflow:hidden; }
.lib-match .lib-match-bar > i { display:block; height:100%; border-radius:99px; background:linear-gradient(90deg,#2dd4bf,#0d9488); transition:width .4s ease; }
.lib-match-text { font-size:12px; font-weight:700; color:var(--ink); white-space:nowrap; }
.lib-match-spinner { width:12px; height:12px; border-radius:50%; border:2px solid rgba(13,148,136,.25); border-top-color:#0d9488; animation: lib-match-spin .8s linear infinite; }
@keyframes lib-match-spin { to { transform: rotate(360deg); } }
/* running 态不再包边框盒（旧版 padding+border 会把这一排撑高，和其它按钮不等高） */
/* 官方 API 配额用完 / 限流中：按钮**变红但不禁用** —— 点下去弹二次确认，确认后强行重试。
   （以前这里是禁用 + 一行"今天配额已用完"的文字，DJ 想手动再试一次都没入口。） */
.lib-match #lib-match-start.is-limited {
  background:#dc2626; color:#fff; border-color:#dc2626;
  box-shadow:0 1px 0 rgba(0,0,0,.06);
}
.lib-match #lib-match-start.is-limited:hover { background:#b91c1c; border-color:#b91c1c; }
.lib-match #lib-match-start.is-limited:disabled { opacity:.5; background:#dc2626; }
.lib-match-flag {
  display:inline-block; margin-left:6px; padding:1px 6px; border-radius:99px;
  font-size:11px; font-weight:800; letter-spacing:.02em;
  background:rgba(255,255,255,.22); color:#fff;
}
html[data-theme="night"] .lib-match #lib-match-start.is-limited { background:#b91c1c; border-color:#ef4444; color:#fff; }
html[data-theme="night"] .lib-match #lib-match-start.is-limited:hover { background:#dc2626; }
/* 候选列表里标出"这个候选来自哪个源" */
.mv-source {
  display:inline-block; margin-left:6px; padding:1px 6px; border-radius:99px;
  font-size:10px; font-weight:800; background:rgba(13,148,136,.12); color:#0d9488;
}

/* 「清理残留」弹窗：分组勾选清单 */
.oc-summary { font-size:13px; font-weight:700; color:var(--ink); margin:10px 0; }
.oc-toolbar { display:flex; gap:8px; margin-bottom:10px; }
.oc-group { border:1px solid var(--line); border-radius:10px; padding:10px 12px; margin-bottom:10px; background:var(--paper); }
.oc-group-head { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.oc-label { display:inline-flex; align-items:center; gap:7px; font-size:13px; cursor:pointer; }
.oc-hint { font-size:11px; margin:4px 0 8px 24px; opacity:.75; }
.oc-items { display:flex; flex-direction:column; gap:2px; margin-left:24px; max-height:190px; overflow:auto; }
.oc-item { display:grid; grid-template-columns:16px minmax(0,1fr) 78px 92px; gap:8px; align-items:center; padding:4px 0; font-size:12px; cursor:pointer; }
.oc-item:hover { opacity:.75; }
.oc-name { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:11px; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.oc-item input[type="checkbox"] { width:14px; height:14px; margin:0; }
#orphan-cleanup .settings-modal { max-height:84vh; overflow:auto; }
